# latexmk configuration file for porous_NS_with_Gridap — theory/mesh_regularity_note
#
# Keep the build clean: route ALL auxiliary/intermediate files into a per-target
# 'latex compilation/<basename>/' subfolder and leave ONLY the PDF beside the
# source. See .agents/rules/clean-latex-compilation.md.

# --- Per-target aux directory -------------------------------------------------
# Compute the target basename from @ARGV rather than relying on %B: TeX Live
# 2023's latexmk 4.79 leaves %B literal inside $aux_dir, which scatters the
# intermediates into a directory actually named '%B'. (Same approach as
# theory/paper/latexmkrc and proof_verification/latexmkrc.)
my $target = "";
foreach my $arg (@ARGV) {
    next if $arg =~ /^-/;
    if ($arg =~ /^(.*)\.tex$/) { $target = $1; last; }
    if (-e "$arg.tex")         { $target = $arg; last; }
}
$target =~ s/.*\///;
$target = "default" if $target eq "";

$aux_dir = "latex compilation/$target";   # all intermediates go here
$out_dir = '.';                            # the PDF stays next to the source

# SyncTeX beside the PDF for editor forward/inverse search; enabled through the
# engine because this latexmk does not honour the $synctex variable.
$pdflatex = 'pdflatex -synctex=1 %O %S';

# Extra extensions for `latexmk -c/-C` to remove.
$clean_ext = 'synctex.gz synctex\(busy\) thm bbl blg';

# This note is standalone: no SIAM class and no bibliography, so no ./siam// on
# TEXINPUTS/BSTINPUTS, and a bare `latexmk` builds the one target here.
@default_files = ('mesh_regularity_note.tex');

print "latexmk: Routing auxiliary files to '$aux_dir/' and PDF to './'\n";
